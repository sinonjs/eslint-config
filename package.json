{
  "name": "@sinonjs/eslint-config",
  "description": "Common eslint config for Sinon",
  "version": "7.0.3",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sinonjs/eslint-config-sinon.git"
  },
  "scripts": {
    "lint": "eslint . ",
    "prettier:check": "prettier --check '**/*.{js, md}'",
    "prettier:write": "prettier --write '**/*.{js, md}'",
    "prepare": "husky",
    "version": "changes --commits --footer",
    "postversion": "git push --follow-tags && npm publish --access public",
    "test": "npm run lint",
    "test:downstream": "./test-downstream.sh"
  },
  "license": "BSD-3-Clause",
  "files": [
    "index",
    "LICENSE",
    "README.md",
    ".browserslistrc"
  ],
  "main": "index.js",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "eslint": "^10.2.0",
    "eslint-plugin-compat": "^7.0.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-mocha": "^11.2.0",
    "globals": "^15.15.0"
  },
  "devDependencies": {
    "@studio/changes": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2"
  },
  "lint-staged": {
    "*.{js,md}": "prettier --check",
    "*.js": "eslint --quiet"
  }
}
